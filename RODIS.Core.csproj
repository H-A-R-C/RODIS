<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RODIS</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Copyright>HARC Services Pty Ltd ($([System.DateTime]::Now.ToString("yyyy")))</Copyright>
    <AssemblyVersion>2.2.$([System.DateTime]::Now.ToString("yyyy")).$([System.DateTime]::Now.ToString("MMdd"))</AssemblyVersion>
    <BaseOutputPath>bin\RODISv2.2</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\Debug\**" />
    <EmbeddedResource Remove="bin\Debug\**" />
    <None Remove="bin\Debug\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Series\StatisticOfTimeSeries.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="GDAL" Version="3.11.3" />
    <PackageReference Include="GDAL.Native" Version="3.11.3" />
    <PackageReference Include="GDAL.Plugins" Version="3.11.3" />
    <PackageReference Include="ncalc" Version="1.3.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="UnitsNet" Version="5.75.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="examples/**/*.cs" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="RODISUnitTests" />
    <InternalsVisibleTo Include="RODIS.Core.Tests" />
    <InternalsVisibleTo Include="RODIS.Advanced" />
    <InternalsVisibleTo Include="RODIS.Advanced.Tests" />
  </ItemGroup>

</Project>

